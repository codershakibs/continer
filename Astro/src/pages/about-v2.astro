---
import Base from '@/layouts/Base.astro';
import AboutHero from '@/components/sections/about-v2/AboutHero.astro';
import AboutIntro from '@/components/sections/about-v2/AboutIntro.astro';
import AboutTestimonials from '@/components/sections/about-v2/AboutTestimonials.astro';
import AboutOperational from '@/components/sections/about-v2/AboutOperational.astro';
import AboutAwards from '@/components/sections/about-v2/AboutAwards.astro';
import AboutTeam from '@/components/sections/about-v2/AboutTeam.astro';
import AboutPrecision from '@/components/sections/about-v2/AboutPrecision.astro';
import Cta from '@/components/sections/shared/Cta.astro';
---

<Base title="About V2 - Logistics Astro Theme" description="Continer is a digital logistics platform built to connect global supply chains, simplify operations, and improve shipment visibility." header="absolute">
  <AboutHero />
  <AboutIntro />
  <AboutTestimonials />
  <AboutOperational />
  <AboutAwards />
  <AboutTeam />
  <AboutPrecision />
  <Cta variant="padding-top-x-bottom-xs" />
</Base>
