---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionTag from '@/components/ui/SectionTag.astro';
import SectionSubHeading from '@/components/ui/SectionSubHeading.astro';
import CaseStudyCard from '@/components/cards/CaseStudyCard.astro';
import Cta from '@/components/sections/shared/Cta.astro';
import { getCaseStudies, renderParts } from '@/lib/content';

const all = await getCaseStudies();

export const getStaticPaths = (async () =>
  (await getCaseStudies()).map((caseStudy) => ({ params: { slug: caseStudy.id }, props: { caseStudy } }))) satisfies GetStaticPaths;

const { caseStudy } = Astro.props as { caseStudy: CollectionEntry<'case-studies'> };
const { data } = caseStudy;
const [intro, outro] = renderParts(caseStudy);
const related = all.filter((item) => item.id !== caseStudy.id).slice(0, 2);
---

<Base title={`${data.title} - Continer`} description={data.metaDescription}>
  <section class="section">
    <div class="container c-container">
      <div class="case-single-content-wrapper">
        <div class="case-top-section">
          <div class="section-heading">
            <SectionTag data-anim="Case.Tag">{data.tag}</SectionTag>
            <div class="section-title-block">
              <h1 data-anim="Case.Title" class="section-title">{data.title}</h1>
            </div>
          </div>
        </div>
        <div data-anim="Case.Card" class="case-single-image-block">
          <Image src={data.singleImage} alt={data.title} loading="eager" widths={[800, 1200, 1600]} sizes="100vw" class="case-single-image" />
        </div>
        <div data-anim="Card.Animation" class="case-single-wrap">
          <div class="case-details c-richtext" set:html={intro} />
        </div>
        <div data-anim="Card.Animation" class="case-details-image-block">
          <Image src={data.detailsImage} alt={data.highlight} widths={[800, 1200, 1600]} sizes="100vw" class="case-details-image" />
        </div>
        <div data-anim="Card.Animation" class="case-details-short-text-block">
          <div class="text-small dark-text">{data.highlight}</div>
        </div>
        <div data-anim="items" class="case-single-grid">
          {data.counters.map((counter) => (
            <div class="case-card">
              <div class="case-item">
                <div class="counter-number-block">
                  <div class="text-l night-color">{counter.value}</div>
                </div>
                <div class="text-regular">{counter.label}</div>
              </div>
              <div class="home-card-absolute-1 light-gray-01"></div>
              <div class="home-card-absolute-2 light-gray-02"></div>
              <div class="home-card-absolute-3 light-gray-03"></div>
              <div class="home-card-absolute-4 light-gray-04"></div>
            </div>
          ))}
        </div>
        <div data-anim="Card.Animation" class="case-single-wrap">
          <div class="case-details c-richtext" set:html={outro} />
        </div>
      </div>
    </div>
  </section>
  <section class="section padding-top-xs-bottom-x">
    <div class="container c-container">
      <div class="case-study-content-wrapper">
        <div class="case-top-section">
          <SectionSubHeading variant="left" tag="MORE CASE STUDIES" title="Explore more logistics projects" />
        </div>
        <div data-anim="Card.Animation" class="case-study-content-wrap">
          <div role="list" class="case-study-section-grid">
            {related.map((item) => (
              <div role="listitem"><CaseStudyCard caseStudy={item} /></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
  <Cta />
</Base>
