---
import Img from '@/components/ui/Img.astro';
import { careerPrecisionPrecisionLogoFlexItems } from '@/data/sections/career';
---
<section class="section padding-top-xs-bottom-x">
  <div class="precision-content-wrapper _01">
    <div>
      <div class="precision-flex" data-anim="Card.Animation">
        {careerPrecisionPrecisionLogoFlexItems.map((item) => (
          <div class="precision-logo-flex" data-anim={item.anim}>
            <div class="precision-logo-block">
              <Img src="/images/Black-Aro-2.svg" alt="" class="precision-logo" loading="eager" />
            </div>
            <div class="precision-logo-block">
              <div class="text-xl black">Precision</div>
            </div>
            <div class="precision-logo-block">
              <Img src="/images/Black-Aro-4.svg" alt="" class="precision-logo" loading="eager" />
            </div>
            <div class="precision-logo-block">
              <div class="text-xl black">Velocity</div>
            </div>
            <div class="precision-logo-block">
              <Img src="/images/Black-Aro-5.svg" alt="" class="precision-logo" loading="eager" />
            </div>
            <div class="precision-logo-block">
              <div class="text-xl black">Network</div>
            </div>
            <div class="precision-logo-block">
              <Img src="/images/Black-Aro-1.svg" alt="" class="precision-logo" loading="eager" />
            </div>
            <div class="precision-logo-block">
              <div class="text-xl black">Telemetry</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
