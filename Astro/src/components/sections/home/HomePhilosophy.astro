---
import BackgroundVideo from '@/components/ui/BackgroundVideo.astro';
import SectionSubHeading from '@/components/ui/SectionSubHeading.astro';
---
<section class="section padding-xs philosophy">
  <div class="philosophy-absolute v1">
    <div class="philosophy-content-wrapper">
      <div class="philosophy-heading-block">
        <SectionSubHeading variant="white-left" tag-class="body-text capital-medium v-subheading-white-left" tag="OUR PHILOSOPHY" title-class="heading v-subheading-white-left" title="The strongest supply chains are built through operational clarity, precise freight routing, and the confidence to move cargo deliberately when time matters most." />
      </div>
      <div class="philosophy-bottom" data-anim="items">
        <div class="text-large white">Marcus Vance</div>
        <div class="text-regular white">Vanguard Logistics, CEO</div>
      </div>
    </div>
  </div>
  <div class="philosophy-video-block">
    <BackgroundVideo name="philosophy-video-2" class="philosophy-video" control>
      <div class="philosophy-video-absolute"></div>
    </BackgroundVideo>
  </div>
</section>
