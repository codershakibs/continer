---
import SectionTag from '@/components/ui/SectionTag.astro';
---
<section class="section padding-top-x-bottm-m">
  <div class="container c-container">
    <div class="section-heading-flex">
      <div class="section-heading left">
        <SectionTag data-anim="Sub.Tag" label-class="body-text capital-medium">EXPLORE LOGISTICS SYSTEM</SectionTag>
        <div class="section-title-text">
          <h2 data-anim="Heading.Lines">Optimizing workflows across core operations, supply-chain execution, and route intelligence to help enterprises move cargo efficiently.</h2>
        </div>
      </div>
      <div data-anim="Sub.Tag">
        <div class="text-regular"><span class="star-red">★</span> Rated 4.9/5 from 50+ organizations</div>
      </div>
    </div>
  </div>
</section>
