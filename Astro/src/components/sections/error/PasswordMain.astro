---
import SectionTag from '@/components/ui/SectionTag.astro';
---
<div class="password-section">
  <div class="password-container c-form" data-form>
    <form method="post" id="email-form" class="utility-page-form">
      <div class="section-heading">
        <SectionTag data-anim="Privacy.Tag" label-class="body-text capital-medium white" for="pass" as="label">PROTECTED</SectionTag>
        <div class="section-title-block">
          <h1 class="section-title white" data-anim="Privacy.Title">Password Protected</h1>
        </div>
      </div>
      <div>
        <div class="text-small isabelline-color" data-anim="Privacy.Text">PROTECTED</div>
      </div>
      <div class="password-button-block" data-anim="Privacy.Text-2">
        <div>
          <input autofocus="true" maxlength="256" name="pass" placeholder="Enter your password" type="password" id="pass" class="password-toggle-field c-input" />
        </div>
      </div>
      <div data-anim="Privacy.Text-3">
        <input type="submit" data-wait="Please wait..." value="Submit" class="contact-white-button c-button" />
      </div>
      <div class="error-message c-form-fail">
        <div class="text-regular body-color">Incorrect password. Please try again.</div>
      </div>
    </form>
  </div>
</div>
