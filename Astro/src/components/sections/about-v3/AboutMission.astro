---
import SectionTag from '@/components/ui/SectionTag.astro';
---
<section class="section">
  <div class="container c-container">
    <div>
      <div class="mission-content-block">
        <div class="section-sub-heading">
          <SectionTag data-anim="Sub.Tag" label-class="body-text capital-medium">OUR MISSION</SectionTag>
          <div>
            <div class="text-s" data-anim="Loading.Text">We empower modern supply chain operators with high-performance digital tools that eliminate transit friction. By combining live telemetry, intelligent routing, and seamless ecosystem workflows, Continer helps global enterprises transform everyday transport challenges into sustainable market advantages.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
