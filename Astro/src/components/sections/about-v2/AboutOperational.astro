---
import BackgroundVideo from '@/components/ui/BackgroundVideo.astro';
import SectionSubHeading from '@/components/ui/SectionSubHeading.astro';
---
<section class="section night-color v1">
  <div>
    <div class="operational-content" data-anim="Loading.Card">
      <BackgroundVideo name="enterprise-video" class="operational-video" control></BackgroundVideo>
      <div class="operational-absolute">
        <div class="operational-card-item">
          <div class="operational-heading-block">
            <SectionSubHeading variant="white-left" tag-class="body-text capital-medium v-subheading-white-left" tag="OPERATIONAL EXCELLENCE" title-class="heading v-subheading-white-left" title="Driving the next generation of global supply chain intelligence with uncompromising standards." />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
