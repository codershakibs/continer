---
import BackgroundVideo from '@/components/ui/BackgroundVideo.astro';
import SectionTag from '@/components/ui/SectionTag.astro';
import AboutTwoVideoTagIconBlockIcon from '@/assets/icons/about-two-video-tag-icon-block-icon.svg';
---
<section class="section padding-xs">
  <div class="container c-container">
    <div class="about-two-content-wrapper">
      <div class="about-two-grid">
        <div class="about-two-card cell-18ba8621e87b9a354961">
          <div class="section-heading left">
            <SectionTag data-anim="About.Tag" label-class="body-text capital-medium white">WHO WE ARE</SectionTag>
            <div class="section-title-block">
              <h1 class="section-title white" data-anim="About.Title">Architecting modern supply technology</h1>
            </div>
          </div>
        </div>
        <div class="about-two-video-block cell-8c2b4fc756f09a354961">
          <BackgroundVideo name="14294690-3840-2160-24fps-1" class="about-two-video" control></BackgroundVideo>
          <div class="about-two-video-absolute">
            <div class="about-two-video-tag-wrap">
              <div class="about-two-video-tag-block" data-anim="About.Button">
                <div class="about-two-video-tag-icon-block">
                  <AboutTwoVideoTagIconBlockIcon class="dark-star" />
                </div>
                <div class="text-regular body-color">4.9/5 from over 600 reviews</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
