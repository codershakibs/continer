---
import BackgroundVideo from '@/components/ui/BackgroundVideo.astro';
import SectionTag from '@/components/ui/SectionTag.astro';
---
<section class="section padding-xs">
  <div class="cta-content-block" data-anim="Loading.Card">
    <div class="cta-absolute">
      <div class="cta-content-wrapper">
        <div class="cta-top-section max-width-572">
          <div class="section-sub-heading">
            <SectionTag data-anim="Sub.Tag" label-class="body-text capital-medium white">ENTERPRISE INFRASTRUCTURE</SectionTag>
            <div>
              <div class="text-n" data-anim="Sub.Title">owering global freight networks with automated telemetry</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="cta-video-wrap">
      <BackgroundVideo name="enterprise-video" class="cta-video-contact" control></BackgroundVideo>
      <div class="cta-video-absolute"></div>
    </div>
  </div>
</section>
