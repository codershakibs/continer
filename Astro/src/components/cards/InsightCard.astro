---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '@/lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
  reverse?: boolean;
}

const { post, reverse = false } = Astro.props;
const { author } = post.data;
---
<a href={`/blog-posts/${post.id}`} class:list={['insights-link', { revarse: reverse }, 'c-inline-block']}>
  {!reverse && (
    <div class="insights-image-block">
      <Image src={post.data.image} alt={post.data.title} widths={[500, 800, 1200]} sizes="(max-width: 767px) 100vw, 50vw" class="insights-image" />
    </div>
  )}
  <div class="insights-cards">
    <div class="blog-item">
      <div class="blog-active-card-top">
        <div class="blog-tag-flex">
          <div class="body-text font-medium-upper">{post.data.tag}</div>
          <div class="blog-fil"></div>
          <div class="body-text font-medium-upper">{formatDate(post.data.date)}</div>
        </div>
        <div class="blog-active-heading-block">
          <div class="text-m">{post.data.title}</div>
        </div>
        <div class="blog-active-summary">
          <p class="text-regular">{post.data.excerpt}</p>
        </div>
      </div>
      {author && (
        <div class="insights-bottom">
          <div class="insights-author-block">
            <Image src={author.image} alt={author.name} widths={[64, 128]} sizes="64px" class="insights-author-image" />
          </div>
          <div class="dispatch-author-info-block">
            <div class="body-text">{author.name}</div>
            <div class="body-text">{author.role}</div>
          </div>
        </div>
      )}
    </div>
  </div>
  {reverse && (
    <div class="insights-image-block">
      <Image src={post.data.image} alt={post.data.title} widths={[500, 800, 1200]} sizes="(max-width: 767px) 100vw, 50vw" class="insights-image" />
    </div>
  )}
</a>
