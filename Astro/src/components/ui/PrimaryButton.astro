---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'base' | 'red-version' | 'transparent' | 'white-version' | 'white-text-and-border';
}

const { variant = 'base', class: className, ...rest } = Astro.props;
const variantClass = variant !== 'base' ? `v-primary-${variant}` : undefined;
---
<a class:list={['primary-btn', variantClass, className, 'c-inline-block']} {...rest}>
  <div class="primary-btn-text-wrap">
    <div class:list={['button-text', variantClass]}><slot /></div>
  </div>
</a>
