---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'base' | 'white';
  icon?: string;
}

const { variant = 'base', icon = '/images/Dark-Aro.svg', class: className, ...rest } = Astro.props;
const variantClass = variant !== 'base' ? `v-dark-${variant}` : undefined;
---
<a class:list={['link-block', className, 'c-inline-block']} {...rest}>
  <div class="primary-btn-inner">
    <div class="primary-btn-text-wrap">
      <div class:list={['button-text', 'dark-600', variantClass]}><slot /></div>
    </div>
    <div class="primary-btn-icon-block">
      <img src={icon} loading="lazy" alt="" class="dard-aro-icon _01" />
      <img src={icon} loading="lazy" alt="" class="dard-aro-icon _02" />
    </div>
  </div>
  <div class:list={['button-line', variantClass]}></div>
</a>
