---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'base' | 'font-600' | 'font-white-600' | 'hide-show' | 'white';
}

const { variant = 'base', class: className, ...rest } = Astro.props;
const variantClass = variant !== 'base' ? `v-secondary-${variant}` : undefined;
---
<a class:list={['link-block', className, 'c-inline-block']} {...rest}>
  <div class:list={['button-fil', variantClass]}></div>
  <div class="primary-btn-text-wrap">
    <div class:list={['button-text', 'dark-600', variantClass]}><slot /></div>
  </div>
  <div class:list={['button-line', variantClass]}></div>
</a>
