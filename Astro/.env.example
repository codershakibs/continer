# Public URL of the deployed site. Used for canonical URLs, Open Graph images, the sitemap and robots.txt.
PUBLIC_SITE_URL=https://www.example.com

# Endpoint that receives contact and newsletter submissions as a JSON POST
# (Formspree, Basin, your own API...). Leave empty to keep forms in demo mode, see src/config/config.json.
PUBLIC_FORM_ENDPOINT=

# Strapi CMS. When STRAPI_URL is set, blog posts, categories, careers, case studies and
# services are loaded from Strapi at build time; when empty, the Markdown in src/content is used.
# STRAPI_TOKEN is a read-only API token (Strapi admin > Settings > API Tokens).
STRAPI_URL=
STRAPI_TOKEN=
