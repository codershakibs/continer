{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tag": {
      "type": "string"
    },
    "byline": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "date": {
      "type": "date"
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "homeImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "singleImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "detailsImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "authorImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "authorName": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "highlight": {
      "type": "string"
    },
    "details1": {
      "type": "richtext"
    },
    "details2": {
      "type": "richtext"
    },
    "summary": {
      "type": "text"
    },
    "details3": {
      "type": "richtext"
    },
    "active": {
      "type": "boolean"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-category.blog-category",
      "inversedBy": "blogPosts"
    },
    "order": {
      "type": "integer",
      "default": 100
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "webflow": {
      "type": "component",
      "repeatable": false,
      "component": "migration.webflow"
    }
  }
}
